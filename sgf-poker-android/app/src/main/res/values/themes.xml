<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Base theme: every Material 3 color role is mapped to a resource from colors.xml.
      Because res/values-night/colors.xml redefines those same resources, the whole
      palette flips in dark mode without a second copy of this theme.
      Only the system-bar contrast flags need a per-mode override (see values-night/themes.xml).
    -->
    <style name="Base.Theme.SGFPoker" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <!-- Background / surfaces -->
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/md_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/md_on_surface_inverse</item>

        <!-- Outlines / scrim -->
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="android:colorControlHighlight">@color/md_outline_variant</item>
        <item name="scrimBackground">@color/md_scrim</item>

        <!-- Component defaults -->
        <item name="toolbarStyle">@style/Widget.SGFPoker.Toolbar</item>
        <item name="materialCardViewStyle">@style/Widget.SGFPoker.CardView</item>
        <item name="drawerArrowStyle">@style/Widget.SGFPoker.DrawerArrow</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/md_primary_container</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
    </style>

    <style name="Theme.SGFPoker" parent="Base.Theme.SGFPoker">
        <!-- Light mode: dark icons on the pale green status bar -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Top app bar: primary container keeps a branded bar that stays readable in both modes -->
    <style name="Widget.SGFPoker.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimaryContainer</item>
        <item name="titleTextColor">?attr/colorOnPrimaryContainer</item>
        <item name="subtitleTextColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.SGFPoker.DrawerArrow" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="color">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- Cards sit one step above the surface so they read in dark mode too -->
    <style name="Widget.SGFPoker.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- Small pill label used for Founder / Member / Guest badges -->
    <style name="TextAppearance.SGFPoker.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.SGFPoker.SectionHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

</resources>
